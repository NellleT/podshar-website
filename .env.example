# --- core ------------------------------------------------------------------
DATABASE_URL="postgresql://podshar:podshar@localhost:5432/podshar?schema=public"
AUTH_SECRET=""                 # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# --- object storage (media mirror) -----------------------------------------
S3_ENDPOINT=""
S3_BUCKET="podshar-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- models ----------------------------------------------------------------
OPENAI_API_KEY=""              # gallery vision comments + assistant

# --- data providers --------------------------------------------------------
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SOUNDCLOUD_CLIENT_ID=""
BRAWL_STARS_API_TOKEN=""       # developer.brawlstars.com, IP-allowlisted
STEAM_API_KEY=""               # Dota 2 via Steam / OpenDota
OPENDOTA_API_KEY=""
OPENWEATHER_API_KEY=""
TRANSPORT_API_BASE="https://transport.opendata.ch/v1"

# --- secret store ----------------------------------------------------------
# Music and finance credentials live here, not in Postgres. The DB stores only
# the reference key (MusicConnection.credentialRef, FinanceConnection.credentialRef).
SECRETS_PROVIDER="local"       # local | vault | doppler
SECRETS_ENCRYPTION_KEY=""      # 32-byte base64, only used when provider=local

# --- scrapers (Python service) ---------------------------------------------
SCRAPER_INTERNAL_TOKEN=""      # shared secret for the scraper -> Next ingest API
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="podshar/0.1"
